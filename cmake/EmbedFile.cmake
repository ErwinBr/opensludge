# Write a C++ header that contains the bytes of a file, such as a font, so
# that we can build it into the executable.
#
# Usage: cmake -DINPUT=<file> -DOUTPUT=<header> -DNAME=<array> -P EmbedFile.cmake
#
# The header has "static const unsigned char <NAME>[]" and
# "static const unsigned int <NAME>Size".

file(READ "${INPUT}" bytes HEX)
string(LENGTH "${bytes}" length)
math(EXPR size "${length} / 2")
# Sixteen bytes on a line.
string(REGEX REPLACE "([0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f])" "\\1\n" bytes "${bytes}")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${bytes}")
get_filename_component(name "${INPUT}" NAME)
set(content "// Generated by EmbedFile.cmake from ${name} - do not edit.\n\n")
string(APPEND content "static const unsigned int ${NAME}Size = ${size};\n")
string(APPEND content "static const unsigned char ${NAME}[] = {\n${bytes}\n};\n")

# We write the header only when its contents change, so that CMake doesn't
# rebuild what includes it when nothing changed.
if(EXISTS "${OUTPUT}")
	file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL content)
	file(WRITE "${OUTPUT}" "${content}")
endif()
